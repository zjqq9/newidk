		make("UIGradient",{Rotation=90,Color=ColorSequence.new(Color3.new(1,1,1),Color3.new(.55,.55,.55))},knob)
		local function update()
			knob.Position=UDim2.new((state[key]-lo)/(hi-lo),-14*((state[key]-lo)/(hi-lo)),0,-4)
			fill.Size = UDim2.new((state[key]-lo)/(hi-lo),0,1,0)
			value.Text = string.format(hi-lo>10 and "%d%s" or "%.1f%s", state[key], suffix or "")
		end
		local function setFromInput(input)
			local fraction = math.clamp((input.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
			local n = lo+(hi-lo)*fraction
			if hi-lo > 10 then n = math.floor(n+.5) else n = math.floor(n*10+.5)/10 end
			changed(key,n); update()
		end
		local sliding = false
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = true; setFromInput(input) end
		end)
		table.insert(pageConnections, UserInputService.InputChanged:Connect(function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromInput(input) end
		end))
		table.insert(pageConnections, UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
		end))
		update()
	end
	local popup
	local function closePopup() if popup then popup:Destroy(); popup=nil end end
	local function popupAt(anchor,w,h)
		closePopup()
		popup=round(make("Frame",{Size=UDim2.fromOffset(w,h),Position=UDim2.fromOffset(
			math.min(anchor.AbsolutePosition.X,gui.AbsoluteSize.X-w-8),math.min(anchor.AbsolutePosition.Y+anchor.AbsoluteSize.Y+6,gui.AbsoluteSize.Y-h-8)),
			BackgroundColor3=C.popup,BorderSizePixel=0,ZIndex=20},gui),4)
		stroke(popup)
		return popup
	end
	local function dropdown(parent,text,key,choices)
		state[key]=state[key] or choices[1]
		local row=make("Frame",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1},parent)
		local l=label(row,text,14); l.Position=UDim2.fromOffset(0,4)
		local b=button(row,state[key].."  ▾",100,22); b.Position=UDim2.fromScale(.5,0); b.Size=UDim2.new(.5,0,1,0); b.TextColor3=C.muted; b.TextSize=14
		b.Activated:Connect(function()
			local menu=popupAt(b,b.AbsoluteSize.X,#choices*24+8)
			for i,choice in ipairs(choices) do
				local item=button(menu,choice,100,24); item.Size=UDim2.new(1,-8,0,24); item.Position=UDim2.fromOffset(4,4+(i-1)*24)
				item.Activated:Connect(function() changed(key,choice); b.Text=choice.."  ▾"; closePopup() end)
			end
		end)
	end

	local function colorControl(parent,name,key,initial)
		state[key]=state[key] or initial
		local row=make("Frame",{Size=UDim2.new(1,0,0,14),BackgroundTransparency=1},parent)
		label(row,name,14)
		local swatch=round(make("TextButton",{Text="",Position=UDim2.new(1,-14,0,0),Size=UDim2.fromOffset(14,14),BackgroundColor3=state[key],AutoButtonColor=false,BorderSizePixel=0},row),3)
		swatch.Activated:Connect(function()
			local pop=popupAt(swatch,244,232)
			local title=label(pop,name,14); title.Position=UDim2.fromOffset(12,12)
			local h,sat,val=state[key]:ToHSV()
			local square=make("TextButton",{Text="",Position=UDim2.fromOffset(12,38),Size=UDim2.fromOffset(190,145),BackgroundColor3=Color3.fromHSV(h,1,1),BorderSizePixel=0},pop)
			local white=make("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0},square)
			make("UIGradient",{Transparency=NumberSequence.new(0,1)},white)
			local black=make("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(),BorderSizePixel=0},square)
			make("UIGradient",{Rotation=90,Transparency=NumberSequence.new(1,0)},black)
			local hue=make("TextButton",{Text="",Position=UDim2.fromOffset(214,38),Size=UDim2.fromOffset(16,145),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0},pop)
			local points={}; for i=0,6 do table.insert(points,ColorSequenceKeypoint.new(i/6,Color3.fromHSV(i/6,1,1))) end
			make("UIGradient",{Rotation=90,Color=ColorSequence.new(points)},hue)
			local field=make("TextBox",{Position=UDim2.fromOffset(12,195),Size=UDim2.fromOffset(164,25),BackgroundColor3=C.frame,TextColor3=C.text,TextSize=14,Font=Enum.Font.Code,ClearTextOnFocus=false,Text="#"..state[key]:ToHex()},pop)
			local done=button(pop,"Done",50,25); done.Position=UDim2.fromOffset(182,195)
			local function update()
				local c=Color3.fromHSV(h,sat,val); changed(key,c); swatch.BackgroundColor3=c; field.Text="#"..c:ToHex(); square.BackgroundColor3=Color3.fromHSV(h,1,1)
				local themeKey=key:match("^theme%.(.+)$"); if themeKey then C[themeKey]=c end
			end
			local active
			local function move(input)
				if not pop.Parent then return end
				if active==square then sat=math.clamp((input.Position.X-square.AbsolutePosition.X)/square.AbsoluteSize.X,0,1); val=1-math.clamp((input.Position.Y-square.AbsolutePosition.Y)/square.AbsoluteSize.Y,0,1)
				elseif active==hue then h=math.clamp((input.Position.Y-hue.AbsolutePosition.Y)/hue.AbsoluteSize.Y,0,1) else return end
				update()
			end
			for _,control in ipairs({square,hue}) do control.InputBegan:Connect(function(input)
				if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then active=control; move(input) end
			end) end
			table.insert(pageConnections,UserInputService.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then move(input) end end))
			table.insert(pageConnections,UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then active=nil end end))
			field.FocusLost:Connect(function() local hex=field.Text:match("^#?(%x%x%x%x%x%x)$"); if hex then h,sat,val=Color3.fromHex(hex):ToHSV(); update() end end)
			done.Activated:Connect(function() closePopup(); if key:match("^theme%.") then render() end end)
		end)
	end

	local function scroll(parent, pos, size)
		local s = make("ScrollingFrame", { Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 5, ScrollBarImageColor3 = C.border, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, parent)
		pad(s, 0); stack(s, 14)
		return s
	end
	local function placeholder() end

	local function combat(parent, sub)
		if sub ~= 1 then placeholder(parent,"Combat",tabs[1][2][sub]); return end
		local left = scroll(parent,UDim2.fromOffset(0,0),UDim2.new(.5,-8,1,0))
		local right = scroll(parent,UDim2.new(.5,8,0,0),UDim2.new(.5,-8,1,0))
		local a = panel(left); a.AutomaticSize=Enum.AutomaticSize.None; a.Size=UDim2.new(1,0,0,272)
		local optionRows = {}
		switch(a,"Legit","combat.legitEnabled",function(enabled)
			for _,row in ipairs(optionRows) do row.Visible = enabled end
		end)
		for _, item in ipairs({{"Predict aim","combat.predictAim"},{"Auto group","combat.autoGroup"},{"Visible check","combat.visibleCheck"},
			{"Flash check","combat.flashCheck"},{"Scope check","combat.scopeCheck"},{"Humanized smooth","combat.humanizedSmooth"},{"Hit chance","combat.hitChance"}}) do
			local row = toggle(a,item[1],item[2]); row.Visible = state["combat.legitEnabled"]; table.insert(optionRows,row)
		end
		local b = panel(left); b.AutomaticSize=Enum.AutomaticSize.None; b.Size=UDim2.new(1,0,0,110)
		slider(b,"Humanized Smoothness","combat.smoothness",0,100,30,"%")
		slider(b,"Hit chance","combat.hitChancePercent",0,100,70,"%")
		local d = panel(right); d.AutomaticSize=Enum.AutomaticSize.None; d.Size=UDim2.new(1,0,0,420); switch(d,"Draw FOV","combat.drawFov")
		section(d,"Render")
		for _, item in ipairs({{"Draw circle outlines","combat.circleOutlines"},{"Draw circle filled","combat.circleFilled"},
			{"Draw center tracer","combat.centerTracer"},{"Draw recoil circle","combat.recoilCircle"}}) do toggle(d,item[1],item[2]) end
		section(d,"Colors")
		colorControl(d,"Circle outlines","combat.color.outlines",Color3.fromRGB(0,0,255))
		colorControl(d,"Circle filled","combat.color.filled",Color3.fromRGB(0,0,255))
		colorControl(d,"Center tracer","combat.color.tracer",Color3.fromRGB(0,255,0))
		colorControl(d,"Recoil circle","combat.color.recoil",Color3.fromRGB(255,0,0))
		section(d,"Configs")
		slider(d,"Line thickness","combat.lineThickness",.5,3,1,"px")
	end
	local function visuals(parent)
		local s = scroll(parent,UDim2.new(),UDim2.new(1,0,1,0))
		local p = panel(s,.5); p.AutomaticSize=Enum.AutomaticSize.None; p.Size=UDim2.new(.5,-8,1,0)
		section(p,"Combo")
		dropdown(p,"Main target","visuals.mainTarget",{"Header","Body","Limbs"})
		dropdown(p,"Aim mode","visuals.aimMode",{"Legit","Rage","Bot"})
		section(p,"Keybind")
		local keyRow=make("Frame",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1},p)
		label(keyRow,"Keybind",14).Position=UDim2.fromOffset(0,4)
		local b = button(keyRow,(state["visuals.keybind"] or Enum.KeyCode.Insert).Name,90,22)
		b.Position=UDim2.new(1,-90,0,0)
		local waiting = false
		b.MouseButton1Click:Connect(function() waiting = true; bindingKey = true; b.Text = "..." end)
		table.insert(pageConnections, UserInputService.InputBegan:Connect(function(input, processed)
			if waiting and not processed and input.UserInputType == Enum.UserInputType.Keyboard then
				waiting = false; task.defer(function() bindingKey=false end); changed("visuals.keybind",input.KeyCode); b.Text = input.KeyCode.Name
			end
		end))
	end
	local function luaPage(parent)
		local left = make("Frame", { Size = UDim2.new(1,-246,1,0), BackgroundTransparency = 1 }, parent)
		local path = round(make("TextLabel", { Size = UDim2.new(1,0,0,38), BackgroundColor3 = C.panel, Text = "Please select a script",
			TextColor3 = C.text, TextSize = 14, Font = Enum.Font.BuilderSansMedium, TextXAlignment = Enum.TextXAlignment.Left }, left),4)
		stroke(path); pad(path,12)
		local editorScroll=round(make("ScrollingFrame",{Position=UDim2.fromOffset(0,54),Size=UDim2.new(1,0,1,-108),BackgroundColor3=C.panel,
			ScrollBarThickness=6,ScrollBarImageColor3=C.border,AutomaticCanvasSize=Enum.AutomaticSize.XY,CanvasSize=UDim2.new(),ClipsDescendants=true},left),5)
		stroke(editorScroll)
		local editor = make("TextBox", { Position = UDim2.fromOffset(42,14), Size = UDim2.new(1,-56,1,-28), BackgroundTransparency = 1,
			Text = editorDraft, TextColor3 = C.text, AutomaticSize=Enum.AutomaticSize.XY,
			Font = Enum.Font.Code, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			MultiLine = true, ClearTextOnFocus = false, TextWrapped = false }, editorScroll)
		local numbers=label(editorScroll,"1",14,C.muted); numbers.Font=Enum.Font.Code; numbers.Position=UDim2.fromOffset(8,14)
		numbers.Size=UDim2.fromOffset(24,0); numbers.AutomaticSize=Enum.AutomaticSize.Y; numbers.TextYAlignment=Enum.TextYAlignment.Top; numbers.TextXAlignment=Enum.TextXAlignment.Right
		local function draftChanged()
			editorDraft=editor.Text
			local _,count=editor.Text:gsub("\n",""); local lines={}; for i=1,count+1 do lines[i]=tostring(i) end
			numbers.Text=table.concat(lines,"\n")
		end
		editor:GetPropertyChangedSignal("Text"):Connect(draftChanged); draftChanged()
		local controls = make("Frame", { Position = UDim2.new(0,0,1,-38), Size = UDim2.new(1,0,0,38), BackgroundTransparency = 1 }, left)
		local explorer = round(make("Frame", { Position = UDim2.new(1,-230,0,0), Size = UDim2.new(0,230,1,0),
			BackgroundColor3 = C.panel, BorderSizePixel = 0 }, parent),5)
		stroke(explorer)
		local title = section(explorer,"Explorer")
		title.Position = UDim2.fromOffset(14,14)
		title.Size = UDim2.new(1,-28,0,14)
		local list = scroll(explorer,UDim2.fromOffset(14,42),UDim2.new(1,-28,1,-56))
		if selectedScript then path.Text=selectedScript end
		local function selectScript(name)
			selectedScript = name; path.Text = "  "..name; editor.Text = scripts[name] or ""
		end
		local function refreshList()
			for _, child in ipairs(list:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
			local names = {"radar_hack.lua","spectator_list.lua","auto_jump.lua","anti_aim.lua","anti_troll.lua"}
			for name in pairs(scripts) do if not table.find(names,name) then table.insert(names,name) end end
			for _, name in ipairs(names) do
				local b = make("TextButton",{Text=name,TextSize=14,Font=Enum.Font.BuilderSansMedium,TextColor3=C.muted,
					BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,Size=UDim2.new(1,0,0,14)},list)
				b.MouseEnter:Connect(function() b.TextColor3=C.text end)
				b.MouseLeave:Connect(function() b.TextColor3=selectedScript==name and C.text or C.muted end)
				b.MouseButton1Click:Connect(function() selectScript(name) end)
			end
		end
		refreshList()
		local function action(text,image,x,w)
			local b=button(controls,"",w,38); b.Position=UDim2.fromOffset(x,0)
			icon(b,image,12,12,C.text); local t=label(b,text,14); t.Position=UDim2.fromOffset(38,12); t.Size=UDim2.new(1,-38,0,14)
			return b
		end
		local clear = action("Clear","clear",0,84); clear.MouseButton1Click:Connect(function() editor.Text = "" end)
		local open = action("Open","open",100,84)
		open.MouseButton1Click:Connect(function() if selectedScript then editor.Text = scripts[selectedScript] end end)
		local save = action("Save","save",200,84)
		save.MouseButton1Click:Connect(function() if selectedScript then scripts[selectedScript] = editor.Text; changed("lua.saved."..selectedScript,editor.Text) end end)
		local execute = action("Execute","play",0,105); execute.Position = UDim2.new(1,-105,0,0)
		execute.MouseButton1Click:Connect(function()
			if options.onExecute then options.onExecute(editor.Text,selectedScript) end
		end)
	end
	local function settings(parent)
		local s = scroll(parent,UDim2.new(),UDim2.new(1,0,1,0))
		local p = panel(s)
		for _, item in ipairs({
			{"Accent","theme.accent",C.accent},{"Accent hovered","theme.accentHovered",C.accentHovered},
			{"Accent active","theme.accentActive",C.accentActive},
			{"Text","theme.text",C.text},{"Text disabled","theme.muted",C.muted},
			{"Button","theme.button",C.button},{"Button hovered","theme.hover",C.hover},
			{"Button active","theme.buttonActive",C.buttonActive},
			{"Frame","theme.frame",C.frame},{"Frame hovered","theme.frameHovered",C.frameHovered},
			{"Frame active","theme.frameActive",C.frameActive},
			{"Title","theme.title",C.title},{"Border","theme.border",C.border},
			{"Window","theme.window",C.window},{"Child","theme.panel",C.panel},
			{"Popup","theme.popup",C.popup},
		}) do colorControl(p,item[1],item[2],item[3]) end
	end
	render = function()
		for _,connection in ipairs(pageConnections) do connection:Disconnect() end
		table.clear(pageConnections)
		closePopup()
		drawNavigation()
		window.BackgroundColor3=C.window; header.BackgroundColor3=C.title; divider.BackgroundColor3=C.border
		for _,child in ipairs(body:GetChildren()) do child:Destroy() end
		local subs = tabs[current][2]
		local content = make("Frame",{Position=UDim2.fromOffset(#subs>0 and 180 or 16,16),Size=UDim2.new(1,#subs>0 and -196 or -32,1,-32),BackgroundTransparency=1},body)
		if #subs>0 then
			local sidebar=make("Frame",{Position=UDim2.fromOffset(16,16),Size=UDim2.new(0,148,1,-32),BackgroundTransparency=1},body)
			for i,name in ipairs(subs) do
				local active=selected[current]==i
				local b=button(sidebar,"",148,38); b.Position=UDim2.fromOffset(0,(i-1)*42)
				b.BackgroundTransparency=active and 0 or 1; b.BackgroundColor3=Color3.fromRGB(21,18,19)
				b:SetAttribute("RestColor",b.BackgroundColor3)
				b:FindFirstChildOfClass("UIStroke").Transparency=active and .25 or 1
				icon(b,subIcons[current][i],12,12,active and C.text or C.muted)
				local t=label(b,name,14,active and C.text or C.muted); t.Position=UDim2.fromOffset(38,12); t.Size=UDim2.new(1,-38,0,14)
				b.Activated:Connect(function() selected[current]=i; render() end)
			end
		end
		if current == 1 then combat(content,selected[1])
		elseif current == 2 then visuals(content)
		elseif current == 3 or current == 4 or current == 5 then placeholder(content,tabs[current][1],subs[selected[current]])
		elseif current == 6 then luaPage(content)
		else settings(content) end
	end
	render()
	gui.Destroying:Connect(function()
		for _,connection in ipairs(connections) do connection:Disconnect() end
		for _,connection in ipairs(pageConnections) do connection:Disconnect() end
	end)
	table.insert(connections,UserInputService.InputBegan:Connect(function(input,processed)
		if not processed and not bindingKey and input.KeyCode==Enum.KeyCode.Insert and not UserInputService:GetFocusedTextBox() then gui.Enabled=not gui.Enabled end
	end))
	local api = { gui = gui, state = state, scripts = scripts }
	function api:show() gui.Enabled = true end
	function api:hide() gui.Enabled = false end
	function api:destroy()
		for _,connection in ipairs(connections) do connection:Disconnect() end
		for _,connection in ipairs(pageConnections) do connection:Disconnect() end
		gui:Destroy()
	end
	return api
end

return ZyrexUI
