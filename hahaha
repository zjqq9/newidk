local function make(class, props, parent)
	local obj = Instance.new(class)
	if obj:IsA("GuiObject") then obj.BorderSizePixel = 0 end
	for key, value in pairs(props) do obj[key] = value end
	obj.Parent = parent
	return obj
end
local function round(obj, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, obj)
	return obj
end
local function stroke(obj)
	make("UIStroke", { Color = C.border, Thickness = 1, Transparency = .25, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, obj)
	return obj
end
local function pad(obj, n)
	make("UIPadding", { PaddingLeft = UDim.new(0,n), PaddingRight = UDim.new(0,n), PaddingTop = UDim.new(0,n), PaddingBottom = UDim.new(0,n) }, obj)
end
local function label(parent, text, size, color)
	return make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1,0,0,size), FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.SemiBold),
		TextSize = size, Text = text, TextColor3 = color or C.text, TextXAlignment = Enum.TextXAlignment.Left }, parent)
end
local function button(parent, text, width, height)
	local b = round(make("TextButton", { Size = UDim2.fromOffset(width,height), BackgroundColor3 = C.button,
		Text = text, FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.SemiBold), TextSize = 14, TextColor3 = C.text, AutoButtonColor = false }, parent), 4)
	stroke(b)
	b.MouseEnter:Connect(function() b.BackgroundColor3 = C.hover end)
	b.MouseLeave:Connect(function() b.BackgroundColor3 = b:GetAttribute("RestColor") or C.button end)
	b.MouseButton1Down:Connect(function() b.BackgroundColor3=C.buttonActive end)
	b.MouseButton1Up:Connect(function() b.BackgroundColor3=C.hover end)
	return b
end
local function stack(parent, gap)
	make("UIListLayout", { Padding = UDim.new(0,gap), SortOrder = Enum.SortOrder.LayoutOrder }, parent)
end
local function panel(parent, width)
	local f = round(make("Frame", { Size = UDim2.new(width or 1, width and -5 or 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.panel, BorderSizePixel = 0 }, parent), 5)
	f.BackgroundTransparency = .4
	stroke(f); pad(f, 14); stack(f, 14)
	return f
end
local function icon(parent, name, x, y, color)
	local data = ICONS[name]
	local holder = make("Frame", {Position=UDim2.fromOffset(x,y), Size=UDim2.fromOffset(14,14), BackgroundTransparency=1}, parent)
	if data then
		for _,run in ipairs(data.runs) do
			make("Frame", {Position=UDim2.new(run[1]/data.w,0,run[2]/data.h,0), Size=UDim2.new(run[3]/data.w,0,1/data.h,0),
				BackgroundColor3=color or C.text, BackgroundTransparency=1-run[4]/255, BorderSizePixel=0}, holder)
		end
	end
	return holder
end
local function section(parent, title)
	local l = label(parent, title, 14, C.muted)
	local width = TextService:GetTextSize(title,14,Enum.Font.Gotham,Vector2.new(1000,20)).X + 8
	make("Frame", {Position=UDim2.fromOffset(width,7), Size=UDim2.new(1,-width,0,1),BackgroundColor3=C.border,BorderSizePixel=0},l)
	return l
end

